# Copia este archivo a .env.local y rellena los valores.
# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Destinatario de los mensajes del formulario de contacto
CONTACT_TO_EMAIL=
# Remitente; onboarding@resend.dev mientras no haya dominio verificado
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"
# Supabase: URL del proyecto y publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
